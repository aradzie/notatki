model Basic Math

field Front
field Back
field Related?
field Extra?

card Card 1

front
<div class="front">{{Front}}</div>
~~~

back
{{FrontSide}}
<hr>
<div class="back">
  {{Back}}

  {{#Related}}
    <p class="sub">Related</p>
    {{Related}}
  {{/Related}}

  {{#Extra}}
    <p class="sub">Extra</p>
    {{Extra}}
  {{/Extra}}
</div>
~~~

styles
@media (min-width: 600px) {
  .card {
    font-family: serif;
    max-width: 40rem;
    margin: 1rem auto;
    padding: 1rem;
    border: 1px solid gray;
    box-shadow: 0 10px 15px rgba(0,0,0,0.1);
  }
}
.front {
  text-align: center;
}
.back {
  text-align: start;
}
.sub {
  font-weight: bold;
  color: gray;
  border-bottom: 1px solid gray;
}
.card p > img:only-child {
  display: block;
  margin: 0 auto;
  max-width: 100%;
  max-height: 400px;
}
~~~

